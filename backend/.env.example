# Environment variables read by the Clientele API.
# For docker compose, copy this file to .env in the repository root (next to
# docker-compose.yml) and replace the placeholder values; compose reads .env from
# there. Otherwise export the variables in your shell. Never commit .env.
# The defaults in backend/src/main/resources/application.yml match docker-compose.yml,
# so none of these are needed for local development with `mvn spring-boot:run`.

SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5332/customer
SPRING_DATASOURCE_USERNAME=change-me
SPRING_DATASOURCE_PASSWORD=change-me

# Secret used to sign JWTs, at least 32 bytes. Required whenever the dev profile is
# not active, including the docker-compose API container. Generate one with:
#   openssl rand -base64 48
# The placeholder is deliberately too short, so the API refuses to start with it.
CLIENTELE_JWT_SECRET=change-me

# Optional first admin account. Set both to create it, or to promote the existing
# account with this email (its password is set to this value). Leave unset for none.
# CLIENTELE_BOOTSTRAP_ADMIN_EMAIL=admin@example.com
# CLIENTELE_BOOTSTRAP_ADMIN_PASSWORD=change-me-to-a-long-password

# Swagger UI at /swagger-ui/index.html is on by default. Set to false to turn it off;
# the OpenAPI document at /v3/api-docs stays available.
# SPRINGDOC_SWAGGERUI_ENABLED=false
